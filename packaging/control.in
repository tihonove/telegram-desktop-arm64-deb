Package: telegram-desktop-arm64
Version: @VERSION@
Architecture: arm64
Maintainer: @MAINTAINER@
Installed-Size: @INSTALLED_SIZE@
Depends: @DEPENDS@
Recommends: @RECOMMENDS@
