#!/bin/sh
# Telegram Desktop: the official arm64 build, repacked from the snap.
# Only the directory with the supplemented libraries goes into LD_LIBRARY_PATH;
# libc, libm and ld-linux always come from the system.
TG=/opt/telegram-desktop
export LD_LIBRARY_PATH="$TG/libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ -z "${QT_QPA_PLATFORM:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    export QT_QPA_PLATFORM=wayland
fi
exec "$TG/app/usr/bin/telegram-desktop" "$@"
